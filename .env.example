# Copy to .env (git-ignored), fill in, then start the server with:
#   source .env && mix phx.server
# Every line needs `export`, or the variable never reaches the server.
# OpenAI or DataForSEO with missing or commented-out lines stays on demo data in dev.

# OpenAI: Seeds, filtering and grouping, SERP labels, Briefs
export OPENAI_API_KEY=sk-...
# Optional; default gpt-6.2-sol. The model must have prices in config/config.exs.
# export OPENAI_MODEL=gpt-6.2-sol

# DataForSEO: phrase ideas, volumes, SERP top 10 (API login and API password, not the account password)
export DATAFORSEO_LOGIN=you@example.com
export DATAFORSEO_PASSWORD=...

# Google Search Console, for Existing Site runs. Optional: without these lines
# the "Connect Search Console" link still shows, connecting reports that
# Search Console is not configured, and Step 6 takes the site's positions and
# Google's first pages from DataForSEO rankings instead. Connected, Search
# Console gives Google's own figures: the site's 90-day average positions,
# with nothing bought.
# (redirect URI: http://localhost:4000/app/search-console/callback)
# Step by step: docs/google-setup.md
# export GOOGLE_CLIENT_ID=...
# export GOOGLE_CLIENT_SECRET=...

# Google PageSpeed Insights, for the Site Scan's phone speed check. Optional: without it
# the scan notes that speed was not checked. Create an API key in Google Cloud
# (enable "PageSpeed Insights API", then APIs & Services > Credentials > Create credentials > API key).
# Step by step: docs/google-setup.md
# export PAGESPEED_API_KEY=...

# Stripe, for paying. Optional in dev: Accounts signed up in dev after the paying migration need no payment
# (older ones need marking, see README "Unpaid Access").
# Without the key and both Price ids, "Buy one research", "Start the monthly plan" and "Manage plan"
# come back with "Payments aren't set up yet.";
# without the webhook secret the webhook answers 503.
# Step by step: docs/stripe-setup.md
# The secret key (sk_test_... in a sandbox, sk_live_... live)
# export STRIPE_SECRET_KEY=sk_test_...
# The Price id of the one-off Single Research
# export STRIPE_PRICE_SINGLE=price_...
# The Price id of the monthly plan (recurring, monthly)
# export STRIPE_PRICE_MONTHLY=price_...
# The webhook signing secret (locally: the one `stripe listen` prints)
# export STRIPE_WEBHOOK_SECRET=whsec_...
