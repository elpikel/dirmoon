<Layouts.landing>
  <:nav>
    <.button id="sign-in-link" variant="dark" href={~p"/users/log-in"}>
      Sign in
    </.button>
  </:nav>

  <section id="landing-hero" class="flex flex-col items-center gap-7 text-center">
    <.eyebrow>Real Google demand, before you write a line of code</.eyebrow>
    <.headline size="hero">
      Before you build it, check
      <:underline>if anyone searches for it.</:underline>
    </.headline>
    <p class="m-0 max-w-[680px] text-[clamp(17px,1.5vw,20px)] leading-normal text-pretty text-body">
      Describe your business or idea in one sentence. dirmoon finds the phrases people really type into Google, counts how many search each month, what an ad click costs and who is on page one today. Then it tells you, in plain words, which niches are worth going after.
    </p>
    <.sign_up_form
      name={:hero}
      form={@sign_up_forms.hero}
      confirmation={Phoenix.Flash.get(@flash, :signed_up)}
    />
  </section>

  <section id="journey" class="mt-24 flex flex-col items-center gap-12 text-center">
    <div class="flex flex-col items-center gap-4">
      <.eyebrow>From idea to answer</.eyebrow>
      <h2 class="m-0 max-w-[760px] text-[clamp(28px,3.4vw,44px)] leading-[1.05] font-extrabold tracking-[-0.035em] text-balance text-ink">
        One sentence in. A ranked answer out.
      </h2>
    </div>
    <.journey id="journey-steps" />
  </section>

  <section
    id="closing"
    class="mt-24 flex flex-col items-center gap-7 border-t border-line pt-20 text-center"
  >
    <.headline level="h2">
      Got an idea for this week?
      <:underline>Check it first.</:underline>
    </.headline>
    <p class="m-0 max-w-[560px] text-[17px] leading-normal text-body">
      Create an account with your email and describe your first idea.
    </p>
    <.sign_up_form
      name={:closing}
      form={@sign_up_forms.closing}
      confirmation={Phoenix.Flash.get(@flash, :signed_up)}
    />
  </section>
</Layouts.landing>
