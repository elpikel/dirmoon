<Layouts.landing flash={@flash}>
  <:nav>
    <.button :if={@current_scope} id="go-to-app" variant="dark" href={~p"/app"}>
      Przejdź do aplikacji
    </.button>
    <.nav_link :if={!@current_scope} id="sign-in-link" href={~p"/users/log-in"}>
      Zaloguj się
    </.nav_link>
  </:nav>

  <section id="landing-hero" class="flex flex-col items-center gap-7 text-center">
    <.eyebrow>Popyt z Google, zanim napiszesz linijkę kodu</.eyebrow>
    <.headline size="hero">
      Zanim zbudujesz, sprawdź,
      <:underline>czy ktoś tego szuka.</:underline>
    </.headline>
    <p class="m-0 max-w-[680px] text-[clamp(17px,1.5vw,20px)] leading-normal text-pretty text-body">
      Opisz biznes w kilku zdaniach. dirmoon znajdzie frazy, które ludzie naprawdę wpisują w Google, sprawdzi, ile osób ich szuka, ile kosztuje kliknięcie i kto dziś zajmuje pierwszą stronę. Potem złoży frazy w nisze, a dla wybranej napisze brief i stronę.
    </p>
    <.sign_up_form
      name={:hero}
      form={@sign_up_forms.hero}
      confirmation={Phoenix.Flash.get(@flash, :signed_up)}
    />
  </section>

  <.how_it_works id="how-it-works" class="mt-20" />

  <section
    id="closing"
    class="mt-24 flex flex-col items-center gap-7 border-t border-line pt-20 text-center"
  >
    <.headline level="h2">
      Masz pomysł na ten tydzień?
      <:underline>Sprawdź go najpierw.</:underline>
    </.headline>
    <p class="m-0 max-w-[560px] text-[17px] leading-normal text-body">
      Załóż konto adresem e-mail i opisz pierwszy pomysł.
    </p>
    <.sign_up_form
      name={:closing}
      form={@sign_up_forms.closing}
      confirmation={Phoenix.Flash.get(@flash, :signed_up)}
    />
  </section>
</Layouts.landing>
